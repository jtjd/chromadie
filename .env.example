VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Legacy compatibility only; prefer VITE_SUPABASE_PUBLISHABLE_KEY above.
VITE_SUPABASE_KEY=
# Optional Supabase Edge Function public-key equivalent; legacy
# SUPABASE_ANON_KEY remains supported by the Edge Function helper.
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key. Never use a VITE_ prefix for this value.
SUPABASE_SECRET_KEY=sb_secret_your-server-key
# Legacy compatibility only; remove after the production transition is verified.
SUPABASE_SERVICE_ROLE_KEY=
VITE_CLOUDFLARE_SITE_KEY=your-turnstile-site-key
VITE_SITE_URL=http://localhost:5173

# M13 profile-parity rollout controls. These are public build configuration,
# not secrets. Keep service authority in Supabase/RPCs and Edge Functions.
VITE_CHROMADIE_ROLLOUT_STAGE=all
VITE_CHROMADIE_INTERNAL_IDS=
VITE_CHROMADIE_COHORT_PERCENT=100
VITE_CHROMADIE_FLAG_COMMERCE=true
VITE_CHROMADIE_FLAG_RICH_MEDIA=true
VITE_CHROMADIE_FLAG_PROFILE_MEDIA_R2=false
# Optional R2-only canary UUIDs. When non-empty, only these users receive the
# R2 media path; the general rollout stage remains unchanged.
VITE_PROFILE_MEDIA_R2_CANARY_IDS=
VITE_CHROMADIE_FLAG_PROFILE_CONFIGURATION_V2=true
VITE_CHROMADIE_FLAG_EXPANDED_ANALYTICS=true
VITE_CHROMADIE_FLAG_SOCIAL_DEPTH=true
VITE_CHROMADIE_FLAG_PROGRESSION_JOURNEY=true

# Server/control-plane values for the staged R2 profile-media migration.
# Never expose the access key, secret, or cleanup secret through VITE_*.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=chm-profile-media-private
R2_PUBLIC_BUCKET=chm-profile-media-public
MEDIA_PUBLIC_ORIGIN=https://media.chm.lol
R2_ACCOUNT_CLEANUP_SECRET=
# Standalone Cloudflare Cron Worker target; keep HTTPS and point it at the
# existing Pages/Functions cleanup endpoint.
CLEANUP_ENDPOINT_URL=https://chm.lol/api/profile-media/account-cleanup
# Server-only exact-URL purge for explicit public deletion/privacy removal.
# The token needs zone cache-purge permission and is never a VITE_* value.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
